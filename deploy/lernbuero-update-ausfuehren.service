# Update aus dem Lehrerbereich: Sicherung, lernbuero-update, danach erneut pruefen (als root).
[Unit]
Description=LernbueroMT: Update ausfuehren
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lernbuero-selbstupdate ausfuehren
TimeoutStartSec=20min
