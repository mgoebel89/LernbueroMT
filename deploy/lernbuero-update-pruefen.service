# Nach einer neuen LernbueroMT-Version suchen (taeglich per Timer und auf Knopfdruck im Lehrerbereich).
[Unit]
Description=LernbueroMT: nach neuer Version suchen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lernbuero-selbstupdate pruefen
TimeoutStartSec=5min
